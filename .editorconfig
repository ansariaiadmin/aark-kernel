root = true

# Consistent formatting across every editor and contributor machine.
# See https://editorconfig.org

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.bat]
end_of_line = crlf

[*.{png,jpg,jpeg,ico,webp,woff,woff2}]
insert_final_newline = false
