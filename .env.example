# AARK Kernel — Environment Template
# Copy to .env: cp .env.example .env
# Generate secrets: openssl rand -base64 32

# === REQUIRED - Must be set, no defaults ===
# Security - generate with: openssl rand -base64 32
API_SECRET_KEY=change-me-generate-with-openssl-rand-base64-32-min-32-chars
POSTGRES_DB=aark_db
POSTGRES_USER=aark_admin
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-base64-32
REDIS_PASSWORD=change-me-generate-with-openssl-rand-base64-32

# Database URLs - constructed from above in compose, but can override
DATABASE_URL=postgresql+asyncpg://aark_admin:change-me@postgres:5432/aark_db
REDIS_URL=redis://:change-me@redis:6379/0

# === OPTIONAL ===
# Nobitex (optional for live trading, paper trading default)
NOBITEX_API_KEY=
NOBITEX_API_SECRET=

# Ollama
LOCAL_OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Cloud LLMs (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=development

# Ports
AARK_BACKEND_PORT=8000
AARK_FRONTEND_PORT=3000
