# ============================================
# AARK Kernel — .env.example — جادوگر v3.0.0 — پشتیبانی صفر — Zero Support
# توضیح فارسی — فقط ضروری‌ها — cp .env.example .env → ./install.sh
# ============================================

# --- امنیت — Security — خودکار — جادوگر رمز بانکی می‌سازه ---
# چیه؟ رمزهای امنیتی — جادوگر 32 کاراکتری می‌سازه — مثل رمز بانکی
API_SECRET_KEY=change-me-generate-with-openssl-rand-base64-32-min-32-chars
POSTGRES_DB=aark_db
POSTGRES_USER=aark_admin
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-base64-32
REDIS_PASSWORD=change-me-generate-with-openssl-rand-base64-32
DATABASE_URL=postgresql+asyncpg://aark_admin:change-me@postgres:5432/aark_db
REDIS_URL=redis://:change-me@redis:6379/0

# --- AI Provider — پرووایدر هوش مصنوعی — برای تحلیل بازار ---
# چیه؟ هوش مصنوعی برای تحلیل ریسک و بازار — مثل مشاور هوشمند
# گزینه‌ها: ollama (لوکال رایگان — https://ollama.com/), openai (GPT-4 — https://platform.openai.com/api-keys), anthropic, groq, mock
# کجا بگیرم؟ Ollama: https://ollama.com/ → نصب → رایگان — یا OpenAI API Key
LOCAL_OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=ollama

# --- Exchange — صرافی — برای ترید واقعی ---
# چیه؟ جایی که ترید می‌کنی — مثل نوبیتکس — برای ترید واقعی نیاز به API Key داره
# گزینه‌ها: nobitex (ایرانی — https://nobitex.ir/ → حساب → API), mock (paper trading بدون پول واقعی — امن — پیش‌فرض)
# کجا بگیرم؟ https://nobitex.ir/panel/api → API Key + Secret
# اگر mock باشه: paper trading — بدون پول واقعی — برای تست عالی
EXCHANGE_PROVIDER=mock
NOBITEX_API_KEY=
NOBITEX_API_SECRET=

# --- SMS Panel — پنل پیامکی — برای ناتیف ترید ---
# چیه؟ وقتی ترید انجام می‌شه یا ریسک بالا می‌ره پیامک می‌ده
# گزینه‌ها: ghasedak (https://ghasedak.me/), kavenegar (https://kavenegar.com/), mock (تو لاگ)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=
GHASEDAK_API_KEY=
KAVENEGAR_API_KEY=

# --- Email — ایمیل — برای ناتیف ترید ---
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=pass

# --- Notification System — سیستم ناتیفیکیشن — سقف 10/10 — جدید v3.0.0 ---
# چیه؟ اطلاع‌رسانی ترید + ریسک + خطا — کانال‌ها: in_app (همیشه روشن) + email + sms + telegram
# تلگرام: @BotFather → /newbot → توکن → getUpdates → chat_id — وقتی ترید یا خطا میاد تلگرام خبر می‌ده
NOTIF_IN_APP=true
NOTIF_EMAIL=false
NOTIF_SMS=false
NOTIF_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ports + Log ---
AARK_BACKEND_PORT=8000
AARK_FRONTEND_PORT=3000
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=development
