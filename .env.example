# AARK Kernel — Environment Template
# Copy to .env: cp .env.example .env

# Security
API_SECRET_KEY=change_me_to_32_bytes_min_jwt_secret
DATABASE_URL=postgresql+asyncpg://aark_admin:secure_aark_pass_2026@postgres:5432/aark_db
REDIS_URL=redis://:redis_aark_secure@redis:6379/0

# Nobitex (optional for live trading, paper trading default)
NOBITEX_API_KEY=
NOBITEX_API_SECRET=

# Ollama
LOCAL_OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Cloud LLMs (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=development

# Ports
AARK_BACKEND_PORT=8000
AARK_FRONTEND_PORT=3000

# Postgres (compose fallback)
POSTGRES_DB=aark_db
POSTGRES_USER=aark_admin
POSTGRES_PASSWORD=secure_aark_pass_2026
REDIS_PASSWORD=redis_aark_secure
